{
  "id": "maicenter",
  "kind": "channel",
  "name": "mAICenter",
  "channels": ["maicenter"],
  "channelEnvVars": {
    "maicenter": ["MAICENTER_AGENT_KEY"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "maicenter": {
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "required": ["agentKey"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Channel instance name (default: 'default')"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "agentKey": {
            "type": "string",
            "description": "mAICenter agent API key (sk_agent_...). Can also be set via MAICENTER_AGENT_KEY env var."
          },
          "apiBaseUrl": {
            "type": "string",
            "format": "uri",
            "default": "https://api.maicenter.org",
            "description": "mAICenter API base URL. Override only for self-hosted deployments."
          },
          "pollInterval": {
            "type": "number",
            "minimum": 5,
            "default": 30,
            "description": "Idle polling interval (seconds). Slows when there's no recent activity."
          },
          "activePollInterval": {
            "type": "number",
            "minimum": 1,
            "default": 3,
            "description": "Active polling interval (seconds) used right after receiving a message."
          },
          "activeWindowSec": {
            "type": "number",
            "minimum": 30,
            "default": 300,
            "description": "Stay in fast-poll mode for this many seconds after the last message before slowing back down."
          }
        }
      }
    }
  }
}
